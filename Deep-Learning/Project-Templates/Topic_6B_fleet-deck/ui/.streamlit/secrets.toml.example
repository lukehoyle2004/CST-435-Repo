# Copy to ui/.streamlit/secrets.toml for local runs, and paste the same three
# lines into Streamlit Community Cloud -> app -> Settings -> Secrets when deploying.
# NEVER commit the real secrets.toml (it is in .gitignore).

API_URL = "https://finetunefleet-api.onrender.com"
SUPABASE_URL = "https://rtlxnyiyoyxvmqhvhcdf.supabase.co"
# The ANON (public) key only: row-level security lets it SELECT the experiment
# leaderboard and the latency aggregates, and nothing else. The service-role key
# must never be placed in this tier.
SUPABASE_ANON_KEY = "your-anon-key"
