# Copy to .env for local development of the API tier (never commit .env).
# Legacy JWT ("eyJ...") keys from Supabase -> Project Settings -> API, which
# supabase-py 2.7.4 expects.
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE-ROLE key: server side only (Render env var). Writes trio_inputs /
# trio_inferences through the trio_log_inference RPC.
SUPABASE_SERVICE_KEY=your-service-role-key
# ANON key: public-safe. Only used by tests/test_supabase_roundtrip.py to prove
# that it can read trio_benchmarks and nothing else.
SUPABASE_ANON_KEY=your-anon-key

# Optional: comma-separated list of allowed CORS origins for the API.
# Default "*" lets classmates' Product 5B interfaces call the service.
ALLOWED_ORIGINS=*
