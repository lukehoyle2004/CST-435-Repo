# Copy to .env for local development (never commit .env).
# Legacy JWT ("eyJ...") keys from Supabase -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE-ROLE key: server side only (Render env var, and the offline scripts that
# load the corpus and the experiments). Writes ftf_documents / ftf_experiments /
# ftf_predictions.
SUPABASE_SERVICE_KEY=your-service-role-key
# ANON key: public-safe. Used only by tests/test_supabase_roundtrip.py to prove it
# can read the experiment store and the latency view, and nothing else.
SUPABASE_ANON_KEY=your-anon-key

# Where the deployed checkpoint comes from (scripts/fetch_model.py).
FTF_MODEL_URL=https://github.com/lukehoyle2004/CST-435-Repo/releases/download/finetunefleet-v1/finetunefleet-deployed.tar.gz

# Optional
ALLOWED_ORIGINS=*
FTF_MAX_RESIDENT=2
