# Copy to .streamlit/secrets.toml for local dev, and paste the same keys into
# the Streamlit Community Cloud "Secrets" box when deploying.
# NEVER commit the real secrets.toml (it is in .gitignore).

API_URL = "https://your-service.onrender.com"   # exact URL from the Render dashboard, or http://localhost:8000
SUPABASE_URL = "https://your-project-ref.supabase.co"
# The ANON key is public-safe (RLS restricts it to SELECT on seq_runs and
# seq_predictions). Do NOT put the service-role key here.
SUPABASE_ANON_KEY = "your-anon-key"
